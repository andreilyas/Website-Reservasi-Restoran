PORT=5000
# Pisahkan beberapa origin dengan koma. Gunakan * hanya jika benar-benar diperlukan.
FRONTEND_ORIGIN=http://localhost:5173,https://website-reservasi-restoran-nb15.vercel.app
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/restokalcer
DATABASE_SSL=false
JWT_SECRET=ganti-dengan-secret-random-minimal-32-karakter
JWT_EXPIRES_IN=2h
DB_POOL_MAX=10
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-long-random-password
